<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_graph"
    app:startDestination="@id/nav_home">

    <fragment
        android:id="@+id/nav_home"
        android:name="com.example.application.ui.home.HomeFragment"
        android:label="Главная" />

    <fragment
        android:id="@+id/nav_myrecipes"
        android:name="com.example.application.ui.myrecipes.MyRecipesFragment"
        android:label="Мои рецепты" />

    <fragment
        android:id="@+id/nav_stats"
        android:name="com.example.application.ui.stats.StatsFragment"
        android:label="Статистика" />

    <fragment
        android:id="@+id/nav_settings"
        android:name="com.example.application.ui.settings.SettingsFragment"
        android:label="Настройки" />

    <fragment
        android:id="@+id/nav_recipe_detail"
        android:name="com.example.application.ui.detail.RecipeDetailFragment"
        android:label="Рецепт">
        <argument
            android:name="recipeId"
            app:argType="long" />
    </fragment>

    <fragment
        android:id="@+id/nav_add_recipe"
        android:name="com.example.application.ui.add.AddRecipeFragment"
        android:label="Новый рецепт" />
</navigation>