<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark">

    <!-- Шапка -->
    <LinearLayout
        android:id="@+id/header"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="20dp"
        android:paddingTop="44dp"
        android:paddingBottom="16dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:id="@+id/backBtn"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/bg_icon_circle"
            android:padding="8dp"
            android:src="@drawable/ic_close"
            app:tint="@color/text_secondary"
            android:rotation="270"/> <!-- Поворачиваем крестик, чтобы получилась стрелка назад -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:fontFamily="@font/montserrat_bold"
            android:text="Новый рецепт"
            android:textColor="@color/text_primary"
            android:textSize="20sp" />
    </LinearLayout>

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:paddingHorizontal="20dp"
        app:layout_constraintTop_toBottomOf="@id/header"
        app:layout_constraintBottom_toTopOf="@id/bottomBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="24dp">

            <!-- Название -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="8dp"
                android:fontFamily="@font/inter_regular"
                android:text="НАЗВАНИЕ БЛЮДА"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:textStyle="bold" />
            <EditText
                android:id="@+id/inputTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_input_field"
                android:fontFamily="@font/inter_regular"
                android:hint="Например, Борщ классический"
                android:inputType="text"
                android:padding="16dp"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_secondary"
                android:textSize="15sp" />

            <!-- Время -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="8dp"
                android:fontFamily="@font/inter_regular"
                android:text="ВРЕМЯ ГОТОВКИ (МИН)"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:textStyle="bold" />
            <EditText
                android:id="@+id/inputTime"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_input_field"
                android:fontFamily="@font/inter_regular"
                android:hint="30"
                android:inputType="number"
                android:padding="16dp"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_secondary"
                android:textSize="15sp" />

            <!-- Сложность -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="8dp"
                android:fontFamily="@font/inter_regular"
                android:text="СЛОЖНОСТЬ"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:textStyle="bold" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView android:id="@+id/diffEasy"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/bg_chip_selector"
                    android:fontFamily="@font/inter_regular"
                    android:gravity="center"
                    android:paddingVertical="12dp"
                    android:text="Легко"
                    android:textColor="@color/text_primary" />

                <TextView android:id="@+id/diffMedium"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_chip_selector"
                    android:fontFamily="@font/inter_regular"
                    android:gravity="center"
                    android:paddingVertical="12dp"
                    android:text="Средне"
                    android:textColor="@color/text_primary" />

                <TextView android:id="@+id/diffHard"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_chip_selector"
                    android:fontFamily="@font/inter_regular"
                    android:gravity="center"
                    android:paddingVertical="12dp"
                    android:text="Сложно"
                    android:textColor="@color/text_primary" />
            </LinearLayout>

            <!-- Категория -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="8dp"
                android:fontFamily="@font/inter_regular"
                android:text="КАТЕГОРИЯ"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:textStyle="bold" />

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:boxCornerRadiusBottomEnd="12dp"
                app:boxCornerRadiusBottomStart="12dp"
                app:boxCornerRadiusTopEnd="12dp"
                app:boxCornerRadiusTopStart="12dp"
                app:boxStrokeColor="@color/purple_primary"
                app:boxBackgroundColor="@color/surface_dark"
                app:boxStrokeWidth="1dp">

                <com.google.android.material.textfield.MaterialAutoCompleteTextView
                    android:id="@+id/categoryDropdown"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/inter_regular"
                    android:inputType="none"
                    android:padding="16dp"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Порции -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="8dp"
                android:fontFamily="@font/inter_regular"
                android:text="КОЛИЧЕСТВО ПОРЦИЙ"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_input_field"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="12dp">

                <!-- Минус -->
                <ImageView
                    android:id="@+id/btnMinus"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_circle_purple"
                    android:padding="8dp"
                    android:src="@drawable/ic_minus"
                    app:tint="@color/text_primary" />

                <!-- Блок с числом и ползунком -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:paddingHorizontal="12dp">

                    <EditText
                        android:id="@+id/servingsValue"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@null"
                        android:fontFamily="@font/montserrat_bold"
                        android:gravity="center"
                        android:inputType="number"
                        android:maxLength="4"
                        android:text="1"
                        android:textColor="@color/text_primary"
                        android:textSize="20sp" />

                    <SeekBar
                        android:id="@+id/servingsSeekBar"
                        android:layout_width="match_parent"
                        android:layout_height="24dp"
                        android:layout_marginTop="-8dp"
                        android:max="1487"
                        android:progress="0"
                        android:paddingStart="0dp"
                        android:paddingEnd="0dp"
                        android:progressDrawable="@drawable/bg_seekbar_track"
                        android:thumb="@android:color/transparent" />
                </LinearLayout>

                <!-- Плюс -->
                <ImageView
                    android:id="@+id/btnPlus"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_circle_purple"
                    android:padding="8dp"
                    android:src="@drawable/ic_plus"
                    app:tint="@color/text_primary" />
            </LinearLayout>

            <!-- Ингредиенты -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="8dp"
                android:fontFamily="@font/inter_regular"
                android:text="ИНГРЕДИЕНТЫ"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:textStyle="bold" />
            <LinearLayout
                android:id="@+id/ingredientsContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <TextView
                android:id="@+id/addIngredientBtn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_dashed_purple"
                android:fontFamily="@font/inter_regular"
                android:gravity="center"
                android:padding="14dp"
                android:text="+ Добавить ингредиент"
                android:textColor="@color/purple_primary"
                android:textSize="14sp"
                android:textStyle="bold" />

            <!-- Инструкция -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="8dp"
                android:fontFamily="@font/inter_regular"
                android:text="ИНСТРУКЦИЯ"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:textStyle="bold" />
            <EditText
                android:id="@+id/inputInstructions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_input_field"
                android:fontFamily="@font/inter_regular"
                android:gravity="top"
                android:hint="Опишите пошагово..."
                android:inputType="textMultiLine"
                android:minLines="5"
                android:padding="16dp"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_secondary"
                android:textSize="15sp" />

        </LinearLayout>
    </ScrollView>

    <!-- Нижняя панель с кнопками -->
    <LinearLayout
        android:id="@+id/bottomBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="20dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/cancelBtn"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_weight="1"
            android:fontFamily="@font/inter_regular"
            android:text="Отмена"
            android:textAllCaps="false"
            android:textColor="@color/text_primary"
            app:cornerRadius="16dp"
            app:strokeColor="@color/text_secondary" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/saveBtn"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:fontFamily="@font/montserrat_bold"
            android:text="Сохранить"
            android:textAllCaps="false"
            android:textColor="@color/text_primary"
            android:textSize="15sp"
            app:backgroundTint="@color/purple_primary"
            app:cornerRadius="16dp" />
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>