<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:orientation="horizontal"
    android:gravity="center_vertical">

    <EditText
        android:id="@+id/ingName"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:layout_weight="2.5"
        android:background="@drawable/bg_input_field"
        android:fontFamily="@font/inter_regular"
        android:hint="Название"
        android:inputType="text"
        android:paddingHorizontal="12dp"
        android:textColor="@color/text_primary"
        android:textColorHint="@color/text_secondary"
        android:textSize="14sp" />

    <EditText
        android:id="@+id/ingQty"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:layout_weight="1.2"
        android:layout_marginStart="8dp"
        android:background="@drawable/bg_input_field"
        android:fontFamily="@font/inter_regular"
        android:hint="Кол-во"
        android:inputType="numberDecimal"
        android:paddingHorizontal="12dp"
        android:textColor="@color/text_primary"
        android:textColorHint="@color/text_secondary"
        android:textSize="14sp" />

    <EditText
        android:id="@+id/ingUnit"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:layout_weight="1"
        android:layout_marginStart="8dp"
        android:background="@drawable/bg_input_field"
        android:fontFamily="@font/inter_regular"
        android:hint="Ед."
        android:inputType="text"
        android:paddingHorizontal="12dp"
        android:textColor="@color/text_primary"
        android:textColorHint="@color/text_secondary"
        android:textSize="14sp" />

    <ImageView
        android:id="@+id/deleteBtn"
        android:layout_width="44dp"
        android:layout_height="48dp"
        android:layout_marginStart="8dp"
        android:background="@drawable/bg_input_field"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:padding="12dp"
        android:src="@drawable/ic_delete"
        app:tint="@color/status_error" />

    <!-- Покрасил корзину в красный (@color/status_error), чтобы сразу бросалось в глаза,
         что это кнопка удаления. Если хочешь серую, поменяй на @color/text_secondary -->

</LinearLayout>