<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="24dp"
    android:background="@drawable/bg_dialog_rounded"
    android:orientation="vertical"
    android:padding="24dp">

    <!-- Шапка -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="@font/montserrat_bold"
            android:text="Поделиться"
            android:textColor="@color/text_primary"
            android:textSize="18sp" />

        <ImageView
            android:id="@+id/closeBtn"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="@drawable/bg_icon_circle"
            android:padding="8dp"
            android:src="@drawable/ic_close"
            app:tint="@color/text_secondary" />
    </LinearLayout>

    <!-- QR-код в белой карточке со скруглениями -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="220dp"
        android:layout_height="220dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="24dp"
        app:cardBackgroundColor="#FFFFFF"
        app:cardCornerRadius="16dp"
        app:cardElevation="0dp"
        app:strokeWidth="0dp">

        <ImageView
            android:id="@+id/qrImage"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="16dp"
            android:scaleType="fitCenter" />
    </com.google.android.material.card.MaterialCardView>

    <!-- Название рецепта -->
    <TextView
        android:id="@+id/recipeName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:fontFamily="@font/montserrat_bold"
        android:gravity="center"
        android:text="Название рецепта"
        android:textColor="@color/text_primary"
        android:textSize="16sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:fontFamily="@font/inter_regular"
        android:gravity="center"
        android:text="Отсканируйте для просмотра"
        android:textColor="@color/text_secondary"
        android:textSize="13sp" />

    <!-- Ссылка -->
    <TextView
        android:id="@+id/recipeLink"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:autoLink="web"
        android:background="@drawable/bg_link_box"
        android:fontFamily="@font/inter_regular"
        android:gravity="center"
        android:padding="12dp"
        android:text="https://recipe-app.ru/recipe/1"
        android:textColor="@color/purple_primary"
        android:textSize="13sp" />

    <!-- Кнопки -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:orientation="horizontal">

        <!-- Кнопка "Скопировать" (прозрачная с обводкой) -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/copyBtn"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:fontFamily="@font/inter_regular"
            android:text="Скопировать"
            android:textAllCaps="false"
            android:textColor="@color/text_primary"
            app:cornerRadius="16dp"
            app:strokeColor="@color/text_secondary" />

        <!-- Кнопка "Сохранить PDF" (фиолетовая) -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/savePdfBtn"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:fontFamily="@font/montserrat_bold"
            android:text="В PDF"
            android:textAllCaps="false"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            app:backgroundTint="@color/purple_primary"
            app:cornerRadius="16dp" />
    </LinearLayout>
</LinearLayout>